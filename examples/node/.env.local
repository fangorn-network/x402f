# Seller: creates the resource and receives payment (needs testnet ETH for gas).
# pubkey 0x147c24c5Ea2f1EE1ac42AD16820De23bBba45Ef6
EVM_PRIVATE_KEY=
# Buyer: pays for access (needs testnet USDC + a little ETH is NOT required —
# gas is paid by the facilitator relayer).
# pubkey 0x7a7849231cF7Ab1EA003BcF0063CB89704D7Cce9
BUYER_PRIVATE_KEY=

# The x402f facilitator that relays register/settle.
FACILITATOR_URL=http://localhost:30333
# Access worker that stores ciphertext and gates DEK release on settlement.
WORKER_URL=https://fangorn-access-worker.quickbeam.workers.dev

# Arbitrum Sepolia deployment.
SETTLEMENT_REGISTRY_ADDR=0x0e7fd0f6219e3bd58ba4d5eb5c53611d48bc8c5e
USDC_CONTRACT_ADDR=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
USDC_DOMAIN_NAME="USD Coin"
VITE_CHAIN_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Price in USDC base units (6 decimals). 1000 = 0.001 USDC.
RESOURCE_PRICE=1000
